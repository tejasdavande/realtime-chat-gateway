PORT=3000

# mongo holds message history
MONGO_URI=mongodb://localhost:27017/chat

# redis carries socket.io pub/sub, presence and rate limits
REDIS_HOST=localhost
REDIS_PORT=6379
# prefix for the socket.io adapter's channels and the rate limit keys, change it when several deployments share one redis
# SOCKET_IO_REDIS_KEY=socket.io

# each user can send at most MESSAGE_RATE_LIMIT messages per window, counted across all instances
# MESSAGE_RATE_LIMIT=20
# MESSAGE_RATE_WINDOW_SECONDS=10

# same secret auth-gateway-service signs its access tokens with
JWT_SECRET=change-me

# services that push notifications send this as x-api-key on POST /notifications (min 16 chars)
NOTIFY_API_KEY=change-me-to-a-long-random-string
